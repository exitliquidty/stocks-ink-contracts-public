# Env vars for script/DeployFactoryV12.s.sol -- see that script's own docstring for the full
# deploy-order explanation and the anvil-fork rehearsal steps to run before ever deploying for
# real. Copy this file to `.env`, fill in the address vars, and pick ONE of the two value blocks
# below (TEST or MAINNET) for the 7 per-generation "protocol constant" vars -- never mix the two.

# ---- Always required ----
POOL_MANAGER_ADDRESS=
DEPLOYER_ADDRESS=
TRUSTED_SIGNER_ADDRESS=
PROTOCOL_TREASURY_ADDRESS=
EXPIRATION_INTERVAL_SECONDS=3600
# Output of script/DeployTokenMetadataRegistry.s.sol, run ONCE, separately, before this script --
# see that script's and TokenMetadataRegistry.sol's own docstrings for why it's a shared singleton
# not redeployed alongside each factory generation.
TOKEN_METADATA_REGISTRY_ADDRESS=

# ---- Per-generation protocol config: pick ONE block ----

# TEST profile (fast iteration -- NOT for a real launch)
# MIN_REWARDS_DURATION_SECONDS/VOTING_DELAY_SECONDS/VOTING_PERIOD_SECONDS must each be >= 3600
# (1 hour) -- StocksStaking and StocksGovernor's own constructors hardcode that as an absolute
# floor (MIN_REWARDS_DURATION / MIN_VOTING_DELAY / MIN_VOTING_PERIOD) and revert otherwise.
# StocksLaunchFactory's constructor now checks all three of these too and reverts at DEPLOY time
# if violated, but the actual floors still come from StocksStaking/StocksGovernor -- don't go
# below 3600 for any of them even though the guard would only catch it, not raise it.
# GRADUATION_USD_THRESHOLD=10000000000000000000
# MIN_REWARDS_DURATION_SECONDS=3600
# MAX_REWARDS_DURATION_SECONDS=31536000
# VOTING_DELAY_SECONDS=3600
# VOTING_PERIOD_SECONDS=3600
# PROPOSAL_THRESHOLD_BPS=25

# MAINNET profile (the real launch)
# GRADUATION_USD_THRESHOLD=8000000000000000000000
# MIN_REWARDS_DURATION_SECONDS=86400
# MAX_REWARDS_DURATION_SECONDS=31536000
# VOTING_DELAY_SECONDS=86400
# VOTING_PERIOD_SECONDS=259200
# PROPOSAL_THRESHOLD_BPS=25
